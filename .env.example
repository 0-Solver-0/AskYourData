# ══════════════════════════════════════════════════════════════════════════════
#  AskYourData — variables d'environnement
#  Copier en .env (ignoré par Git) et compléter. Ne jamais commiter de clé.
# ══════════════════════════════════════════════════════════════════════════════

# ── Base NL2SQL (pgvector) ────────────────────────────────────────────────────
NL2SQL_DB_PASSWORD=nl2sql

# ── API ───────────────────────────────────────────────────────────────────────
SECRET_KEY=changeme_in_production

# ── Odoo ──────────────────────────────────────────────────────────────────────
ODOO_DB_PASSWORD=odoo
ODOO_MASTER_PASSWORD=admin

# ── Base source interrogée (compte par défaut, id=1) ─────────────────────────
# Appliqué à chaque démarrage de schema_service : le .env fait foi pour ce compte.
SOURCE_DB_HOST=postgres_odoo
SOURCE_DB_PORT=5432
SOURCE_DB_NAME=odoo            # nom de la base créée dans Odoo
SOURCE_DB_USER=odoo
SOURCE_DB_SCHEMA=public

# ── Exécution SQL en lecture seule (incrément 4) ──────────────────────────────
EXEC_DB_USER=askyourdata
EXEC_DB_PASSWORD=

# ── Fournisseurs LLM par rôle (incrément 6, profils dans config/llm_providers.yaml)
PREP_PROVIDER=meta_spark
PREP_FALLBACK=baseten_spark_open
SQL_PROVIDER=meta_spark
SQL_FALLBACK=baseten_spark_open

# ── Clés API (une par fournisseur utilisé) ────────────────────────────────────
META_API_KEY=
BASETEN_API_KEY=
FIREWORKS_API_KEY=
LOCAL_API_KEY=

# ── Recherche de schéma ─────────────────────────────────────────────────────
# legacy   : score unique (comportement jusqu'à la PR #9)
# coverage : tables d'abord, puis colonnes table par table, pondérées par leur rareté,
#            et sélection par couverture des éléments de la question
SEARCH_MODE=legacy
# Mots de contexte autour de chaque élément encodé en mode coverage (0 : l'élément seul)
SEARCH_ELEMENT_CONTEXT=2

# ── Embedder local (schema_service) ─────────────────────────────────────────
# Dossier du modèle dans ./models/ ; changer de modèle impose de relancer POST /index
#   all-MiniLM-L6-v2      384 dimensions, CPU, par défaut
#   Qwen3-Embedding-0.6B  1024 dimensions (réductible), consignes ajoutées automatiquement
EMBEDDER_MODEL=all-MiniLM-L6-v2
# cpu | cuda | auto  (cuda : lancer avec docker-compose.gpu.yml)
EMBEDDER_DEVICE=cpu
# Dimension réduite (Qwen3-Embedding : 32 à 1024) ; vide = dimension native du modèle
EMBEDDER_DIM=
# Mémoire du conteneur schema_service (Qwen3-Embedding sur CPU : 4G minimum)
SCHEMA_SERVICE_MEMORY=4G
