# ══════════════════════════════════════════════════════════════════════════════
#  AskYourData — variables d'environnement
#  Copier en .env (ignoré par Git) et compléter. Ne jamais commiter de clé.
# ══════════════════════════════════════════════════════════════════════════════

# ── Base NL2SQL (pgvector) ────────────────────────────────────────────────────
NL2SQL_DB_PASSWORD=nl2sql

# ── API ───────────────────────────────────────────────────────────────────────
SECRET_KEY=changeme_in_production

# ── Odoo ──────────────────────────────────────────────────────────────────────
ODOO_DB_PASSWORD=odoo
ODOO_MASTER_PASSWORD=admin

# ── Base source interrogée (compte par défaut, id=1) ─────────────────────────
# Appliqué à chaque démarrage de schema_service : le .env fait foi pour ce compte.
SOURCE_DB_HOST=postgres_odoo
SOURCE_DB_PORT=5432
SOURCE_DB_NAME=odoo            # nom de la base créée dans Odoo
SOURCE_DB_USER=odoo
SOURCE_DB_SCHEMA=public

# ── Exécution SQL en lecture seule ────────────────────────────────────────────
# Rôle créé par tools/create_readonly_role.py (choisir un mot de passe avant de le lancer)
EXEC_DB_USER=askyourdata
EXEC_DB_PASSWORD=
# Délai maximal par requête (ms) et coût estimé maximal (EXPLAIN) avant refus
EXEC_TIMEOUT_MS=10000
EXEC_MAX_COST=5000000

# ── Fournisseurs LLM par rôle (profils dans config/llm_providers.yaml) ─────────
# prep : découpage de la question ; sql : génération et correction du SQL
# Secours vide = désactivé (benchmarks : un seul modèle par rôle)
PREP_PROVIDER=meta_spark
PREP_FALLBACK=baseten_spark_open
SQL_PROVIDER=meta_spark
SQL_FALLBACK=baseten_spark_open
# Raisonnement par rôle (vide = valeur du profil) : minimal, low, medium, high, xhigh, max
PREP_REASONING=low
SQL_REASONING=

# ── Question dictée (Muse Voice Transcribe, même clé META_API_KEY) ─────────────
VOICE_PROVIDER=meta_voice
VOICE_LANGUAGES=English,French
# Micro : durée maximale (s), silence après la parole qui envoie (ms), aucun son au début → arrêt sans envoi (ms)
VOICE_MAX_SECONDS=20
VOICE_SILENCE_MS=2000
VOICE_NO_SPEECH_MS=5000

# ── Clés API (une par fournisseur utilisé ; jamais dans Git ni dans la conversation)
META_API_KEY=
BASETEN_API_KEY=
LOCAL_API_KEY=

# ── Embedder local (schema_service) ─────────────────────────────────────────
# Dossier du modèle dans ./models/ ; changer de modèle impose de relancer POST /index.
# Règle du hackathon : uniquement des modèles Meta. Par défaut facebook/contriever-msmarco
# (Meta AI, open source, 768 dimensions, CPU) :
#   huggingface-cli download facebook/contriever-msmarco --local-dir models/contriever-msmarco
EMBEDDER_MODEL=contriever-msmarco
# Option : facebook/drama-base (Meta AI, 2025, dérivé de Llama 3.2, CC-BY-NC 4.0) :
#   huggingface-cli download facebook/drama-base --local-dir models/drama-base
#   EMBEDDER_MODEL=drama-base, EMBEDDER_BACKEND=drama, EMBEDDER_TRUST_REMOTE_CODE=true
#   (échelle de scores plus basse : recalibrer les seuils, tools/calibrate_search.py)
EMBEDDER_BACKEND=sentence_transformers
EMBEDDER_TRUST_REMOTE_CODE=false
# cpu | cuda | auto  (cuda : lancer avec docker-compose.gpu.yml)
EMBEDDER_DEVICE=cpu
# Dimension réduite (modèles qui l'acceptent) ; vide = dimension native du modèle
EMBEDDER_DIM=
# Mémoire du conteneur schema_service
SCHEMA_SERVICE_MEMORY=4G
# Seuils de la recherche structurée, propres à l'échelle de l'embedder (tools/calibrate_search.py)
STRUCTURED_MIN_SIMILARITY=0.6
STRUCTURED_TABLE_PIECE_MIN=0.6
STRUCTURED_SUBJECT_MARGIN=0.06
# Juge du sujet (Muse Spark 30B, rôle prep) : appelé quand l'écart entre les 2 premières tables
# est sous ce seuil ; 0 = jamais, 1 = toujours
STRUCTURED_JUDGE_GAP=0.05
