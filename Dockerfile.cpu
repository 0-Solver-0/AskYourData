# ══════════════════════════════════════════════════════════════════════════════
#  AskYourData — Dockerfile.cpu (seule image du projet)
#  Utilisé par : schema_service (embedder local) + api_service (Flask)
#
#  Python 3.11 slim, sans CUDA. PyTorch est installé en version CPU uniquement
#  (dépendance de sentence-transformers) pour garder une image légère.
# ══════════════════════════════════════════════════════════════════════════════

FROM python:3.11-slim AS base

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        curl \
        libgomp1 \
        libpq-dev \
        gcc \
        postgresql-client \
    && rm -rf /var/lib/apt/lists/*

# ── Dépendances Python ────────────────────────────────────────────────────────
FROM base AS deps

WORKDIR /deps

RUN pip install --upgrade pip && \
    pip install torch --index-url https://download.pytorch.org/whl/cpu && \
    pip install \
        flask==3.0.3 \
        gunicorn==22.0.0 \
        requests==2.32.3 \
        python-dotenv==1.0.1 \
        sentence-transformers==3.0.1 \
        psycopg2-binary==2.9.9 \
        pgvector==0.3.2 \
        pyyaml==6.0.2

# ── Image finale ───────────────────────────────────────────────────────────────
FROM base AS final

COPY --from=deps /usr/local/lib/python3.11/site-packages \
                 /usr/local/lib/python3.11/site-packages
COPY --from=deps /usr/local/bin /usr/local/bin

WORKDIR /app

COPY schema_service/ ./schema_service/
COPY api_service/    ./api_service/
COPY config/         ./config/

ENV PYTHONPATH=/app \
    OMP_NUM_THREADS=8 \
    TOKENIZERS_PARALLELISM=false \
    CUDA_VISIBLE_DEVICES=""

EXPOSE 8002 5000

CMD ["python3", "-c", "print('Specify command via docker-compose')"]
